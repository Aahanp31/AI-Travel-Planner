# Backend Environment Variables
# Copy this file to .env for local development

# Database Configuration
# Development: sqlite:///travel_planner.db
# Production (Supabase PostgreSQL): postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///travel_planner.db

# JWT Secret Key - MUST be changed in production
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# Frontend URLs for CORS (comma-separated)
# Development: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_URLS=http://localhost:3000

# Google OAuth Client ID (must match frontend)
GOOGLE_CLIENT_ID=your-google-client-id-here

# OpenAI API Key for AI agents
OPENAI_API_KEY=your-openai-api-key-here

# Server Port (optional, defaults to 4000)
PORT=4000
