# Backend Environment Variables
# Copy this file to .env for local development

# Required
PORT=4000
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://user:pass@localhost:5432/travel_planner
JWT_SECRET_KEY=your-secret-key-change-in-production

# CORS — comma-separated allowed frontend origins
# Development: http://localhost:3000
# Production:  https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_URLS=http://localhost:3000

# Optional — Google OAuth (for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Optional — NewsData.io (for destination news tab)
NEWS_API_KEY=your-newsdata-api-key-here

# Optional — Redis (for shared L2 cache across workers)
REDIS_URL=redis://localhost:6379/0
